# vim: filetype=bash

# A common rc file for various POSIX compliant shells

source "$XDG_CONFIG_HOME/shell/exports"
source "$XDG_CONFIG_HOME/shell/aliases"
source "$XDG_CONFIG_HOME/shell/functions"

if [[ "$OSTYPE" == "linux-gnu"* ]]; then
  eval "$(keychain add --eval --noask --nocolor --quick --quiet --timeout 60 --ignore-missing --absolute --dir ${XDG_RUNTIME_DIR}/keychain id_ed25519_codeberg id_ed25519_github)"
elif [[ "$OSTYPE" == "darwin"* ]]; then
  ssh-add --apple-load-keychain -q
fi

# linux
if [ -f '/home/linuxbrew/.linuxbrew/bin/brew' ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# macos
if [ -f '/opt/homebrew/bin/brew' ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
