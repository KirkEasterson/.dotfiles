{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "plan",
  "permission": {
    "*": "ask",
    "bash": "ask",
    "glob": "ask",
    "edit": "ask",
    "webfetch": "ask"
  },
  "plugin": [],
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b"
        },
        "qwen2.5-coder:32b": {
          "name": "qwen2.5-coder:32b"
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b"
        },
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        }
      }
    }
  },
  "experimental": { "disable_paste_summary": true }
}
