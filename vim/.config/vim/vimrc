"""""""""" OPTIONS
let mapleader=" " " leader is space
let g:mapleader = "\<Space>"

set background=dark
colorscheme elflord

set runtimepath^=$XDG_CONFIG_HOME/vim
set runtimepath+=$XDG_DATA_HOME/vim
set runtimepath+=$XDG_CONFIG_HOME/vim/after

set packpath^=$XDG_DATA_HOME/vim,$XDG_CONFIG_HOME/vim
set packpath+=$XDG_CONFIG_HOME/vim/after,$XDG_DATA_HOME/vim/after

let g:netrw_home = $XDG_DATA_HOME."/vim"
call mkdir($XDG_DATA_HOME."/vim/spell", 'p')

set backupdir=$XDG_STATE_HOME/vim/backup | call mkdir(&backupdir, 'p')
set directory=$XDG_STATE_HOME/vim/swap   | call mkdir(&directory, 'p')
set undodir=$XDG_STATE_HOME/vim/undo     | call mkdir(&undodir,   'p')
set viewdir=$XDG_STATE_HOME/vim/view     | call mkdir(&viewdir,   'p')

if !has('nvim') | set viminfofile=$XDG_STATE_HOME/vim/viminfo | endif

set updatetime=50 " fast update times

set completeopt=menu,menuone,noselect,fuzzy
set number relativenumber " turn hybrid line numbers on
set cursorline " highlight current line
set termguicolors
set confirm

set incsearch " highlight matches as you type
set hlsearch " highlight matches once a search is complete
set nohlsearch " turn off search highlight

set autoindent " new lines inherit the indentation of previous lines.
set nowrap " don't wrap lines
set linebreak " avoid wrapping a line in the middle of a word

syntax enable " enable syntax highlighting
set showmatch " highlight matching [{()}]

set scrolloff=4 " scroll when x away from edge
set signcolumn=yes " column for linting
set colorcolumn=80 " 80col limit

set tabstop=4 " number of visual spaces per TAB
set softtabstop=4 " number of spaces in tab when editing
set shiftwidth=4 " number of spaces when indenting with <>
filetype indent on " load filetype-specific indent files
filetype plugin indent on " TODO: is this line redundant?

let g:highlightedyank_highlight_duration = 100

set mouse=a " enable mouse for scrolling and resizing
set wildmenu " visual autocomplete for command menu
set lazyredraw " redraw only when we need to.
set exrc " use local vimrc, if it exists

let &t_SI = "\e[6 q" " vertical bar in insert mode
let &t_EI = "\e[2 q" " block in normal mode

" use rg for grep
if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case\ --hidden
  set grepformat=%f:%l:%c:%m
endif

" netrw options
let g:netrw_liststyle = 3 " tree view
let g:netrw_banner = 0 " hide the top banner
let g:netrw_winsize = 25 " fix the left split width
let g:netrw_browse_split = 0 " open files in the previous window
let g:netrw_altfile = 1 " keep the alternate file correct

"""""""""" MAPPINGS
" navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" center results
nnoremap n nzzzv
nnoremap N Nzzzv
nnoremap J mzJ`z
nnoremap <C-i> <C-i>zz
nnoremap <C-o> <C-o>zz
nnoremap <C-u> <C-u>zz
nnoremap <C-d> <C-d>zz

" easier undos
inoremap , ,<c-g>u
inoremap . .<c-g>u
inoremap [ [<c-g>u
inoremap ! !<c-g>u
inoremap ? ?<c-g>u

" easy saving/quitting
nnoremap <leader>w :w<cr>
nnoremap <leader>q :q<cr>
nnoremap <leader>z :qa<cr>

" rehighlight indentation
vnoremap < <gv
vnoremap > >gv

" rehighlight crementing
vnoremap <C-a> <C-a> gv
vnoremap <C-x> <C-x>gv

" quickfix navigation
nnoremap [Q :cfirst<CR>
nnoremap ]q :cprev<CR>
nnoremap [q :cnext<CR>
nnoremap ]Q :clast<CR>
function! ToggleQuickfix()
    let qf_open = 0
    for win in range(1, winnr('$'))
        if getwinvar(win, '&buftype') == 'quickfix'
            let qf_open = 1
            break
        endif
    endfor
    if qf_open
        cclose
    else
        copen
    endif
endfunction
nnoremap <silent> <leader>tq :call ToggleQuickfix()<CR>


" locationlist navigation
nnoremap [L :lfirst<CR>
nnoremap ]l :lprev<CR>
nnoremap [l :lnext<CR>
nnoremap ]L :llast<CR>

" delete current buffer
nnoremap <leader>bd :bdelete<CR>

" don't move cursor on yank
vnoremap y ygv<ESC>

" use system clipboard
noremap <leader>x "+x
noremap <leader>y "+y
noremap <leader>p "+p
noremap <leader>P "+P

" don't add brackets to jump list
nnoremap { :keepjumps normal! {<CR>
nnoremap } :keepjumps normal! }<CR>
vnoremap { :keepjumps normal! gv{<CR>
vnoremap } :keepjumps normal! gv}<CR>

" toggle relative linenumber
nnoremap <leader>rt :set relativenumber!<CR>

" toggle fold under cursor
nnoremap <Tab>za

"""""""""" AUTOCMDS
augroup WrapLineInLatexFile
	autocmd!
	autocmd FileType tex setlocal wrap
augroup END

augroup WrapLineInMarkdownFile
	autocmd!
	autocmd FileType markdown setlocal wrap
augroup END

" remove trailing whitespace on each save
autocmd BufWritePre * :%s/\s\+$//e
